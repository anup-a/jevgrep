[1.612, "o", "\u001b[2m# Note the uncertain line. --threshold asks how probable the answer is;\u001b[0m\r\n"]
[1.012, "o", "\u001b[2m# --min-confidence asks how sure the model is. Low confidence never matches,\u001b[0m\r\n"]
[1.011, "o", "\u001b[2m# in either direction, so ambiguous records get escalated, not guessed at.\u001b[0m\r\n"]
[1.007, "o", "\u001b[2m# And the exit codes are grep's, so it drops straight into a shell:\u001b[0m\r\n"]
